# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# The college this assistant serves. Used by the tools, the prompts and the knowledge base
# (the documents in knowledge/ contain {{COLLEGE_NAME}}, {{COLLEGE_DOMAIN}} and
# {{HELPDESK}} placeholders that are filled in at ingestion time).
# Leave HELPDESK_EMAIL empty unless you know the real address.
# After changing these, re-run the ingestion script.
COLLEGE_NAME=Netanya Academic College
COLLEGE_DOMAIN=netanya.ac.il
HELPDESK_EMAIL=

# PostgreSQL (Docker). The defaults below work out of the box for local development.
POSTGRES_USER=phishcheck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phishcheck
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Embeddings (downloaded automatically on first use, ~130 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Flask
FLASK_PORT=5000
